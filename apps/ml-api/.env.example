# ML Microservice Environment Variables
PORT=8000
HOST=0.0.0.0

# Database Credentials (Optional - Graceful fallback if omitted)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Model & Scaler Paths (Defaults to ./models/)
MODEL_PATH=./models/isolation_forest_v1.pkl
SCALER_PATH=./models/feature_scaler_v1.pkl

# Base Camp Default Reference Coordinates (Zero hardcoding)
DEFAULT_BASE_LAT=30.3165
DEFAULT_BASE_LON=78.0322
DEFAULT_DIFFICULTY_SCORE=2.0

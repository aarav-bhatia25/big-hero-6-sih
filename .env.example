NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_MAPTILER_KEY=
# Required by all server deployments. Generate a random value, e.g. `openssl rand -base64 48`.
SESSION_SECRET=
ALCHEMY_SEPOLIA_URL=
DEPLOYER_PRIVATE_KEY=
SEPOLIA_CHAIN_ID=11155111

# Supabase — Project Settings -> API Keys
# NEVER put real values in this file: it is tracked by git.
# Put real values in .env.local (gitignored) instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Dedicated Supabase JWT secret used only to mint 15-minute Realtime tokens.
# Keep it server-only; it must match the active HS256 signing secret in Supabase.
SUPABASE_REALTIME_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Identity issuance — generate with: pnpm identity:keygen
IDENTITY_SIGNING_KEY=
KYC_HASH_SALT=

# --- Block 3: Blockchain anchoring ---
# Local Hardhat: CHAIN_RPC_URL=http://127.0.0.1:8545, CHAIN_ID=31337,
# ANCHOR_PRIVATE_KEY=<hardhat account #0 key>, IDENTITY_REGISTRY_ADDRESS=<deployed addr>,
# INCIDENT_REGISTRY_ADDRESS=<deployed addr>.
# Sepolia: set ALCHEMY_SEPOLIA_URL + DEPLOYER_PRIVATE_KEY, then set the two
# deployed registry addresses below. The web server uses this configuration in
# preference to the local Hardhat values.
SEPOLIA_IDENTITY_REGISTRY_ADDRESS=
SEPOLIA_INCIDENT_REGISTRY_ADDRESS=
CHAIN_RPC_URL=
IDENTITY_REGISTRY_ADDRESS=
INCIDENT_REGISTRY_ADDRESS=
ANCHOR_PRIVATE_KEY=
CHAIN_ID=

# Voice transcription. Leave blank to keep the voice feature visibly disabled.
SARVAM_API_KEY=
# Optional Sarvam model overrides for authority AI briefs and speech input.
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
# Used only for the emergency-identification photo profile and for the
# selected international translation fallback; never expose this in the client.
OPENAI_TEXT_MODEL=gpt-5

# Optional live emergency notifications (no delivery is attempted unless complete).
# For a free Resend test to the email that owns the Resend account, use
# EMERGENCY_FROM_EMAIL=onboarding@resend.dev. Verify your own domain before
# sending alerts to any other recipient.
RESEND_API_KEY=
EMERGENCY_FROM_EMAIL=
# Resend only accepts mail for the address that owns the account while the
# sandbox sender or an unverified domain is in use, so every alert is routed to
# this one verified inbox instead of the contact's own address. The alert body
# still names the contact it was meant for. Leave this variable set to an empty
# value once your own sending domain is verified, to deliver to each contact.
EMERGENCY_ALERT_RECIPIENT=

# Provisioned native/hardware BLE relay gateways use this server-only key when
# they upload a packet after reconnecting. Never expose it to the browser.
PRAHARI_MESH_GATEWAY_KEY=
# Gateway devices additionally require (outside the web deployment):
# PRAHARI_GATEWAY_ID=GW-UNIQUE-ID
# PRAHARI_API_BASE_URL=https://your-prahari-deployment.example

# Emergency clothing-identification profile. Keep this key server-only: the
# photo is sent from the Next.js route to the Responses API and is not saved.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5

# India hazard alerts — no API key is needed. Prahari reads the official NDMA
# SACHET feed server-side and caches it for 5 minutes by default.
HAZARD_ALERT_CACHE_TTL_MS=300000

# Offline base-map tiles must come from a self-hosted or licensed provider
# whose terms explicitly allow pre-download/offline caching. Do not point this
# at tile.openstreetmap.org: its public tile policy forbids offline downloads.
# Example: https://maps.example.com/india/{z}/{x}/{y}.png
NEXT_PUBLIC_OFFLINE_TILE_TEMPLATE=
NEXT_PUBLIC_OFFLINE_TILE_ATTRIBUTION=

# Realtime service only: comma-separated web origins allowed to connect.
CORS_ORIGINS=http://localhost:3000
